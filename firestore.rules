rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users profile
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Family members and invitations
    match /family_members/{inviteId} {
      allow read, write: if true;
    }

    // Location requests (Consent-based sharing)
    match /location_requests/{requestId} {
      allow read, write: if true;
    }
    
    // Wearable device registry
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    // Pre-registered device catalog
    match /device_catalog/{serialId} {
      allow read, write: if true;
    }

    // Safe check-ins ("I AM SAFE")
    match /safe_checkins/{checkinId} {
      allow read, write: if true;
    }

    // SOS Emergency Alerts
    match /emergency_alerts/{alertId} {
      allow read, write: if true;
    }

    // Safe Shelters
    match /shelters/{shelterId} {
      allow read, write: if true;
    }

    // Official Advisories
    match /public_advisories/{advisoryId} {
      allow read, write: if true;
    }

    // Government & Civil Defense aggregated count
    match /civil_defense_metrics/{metricId} {
      allow read, write: if true;
    }

    // Tamper-Proof Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}
